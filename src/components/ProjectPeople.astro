---
// Lista de contribuidores de um projeto (vem do GitHub; ajustes em `people`, src/data/site.ts).
import type { Person } from '../utils/github';

interface Props {
  people: Person[];
}
const { people } = Astro.props;
---

<ul class="people">
  {people.map((person) => (
    <li>
      <a href={person.link} target="_blank" rel="noopener noreferrer">
        <img src={person.avatar} alt="" width="56" height="56" loading="lazy" />
        <span class="name">{person.name}</span>
        <span class="via">
          {person.linkLabel}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .people {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    grid-template-areas:
      'img name'
      'img via';
    align-items: center;
    column-gap: 1rem;
    padding: 1rem;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--people-border, var(--border));
    border-radius: var(--radius);
    transition:
      border-color 200ms ease,
      transform 200ms ease;
  }
  a:hover {
    border-color: currentColor;
    transform: translateY(-2px);
  }
  img {
    grid-area: img;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
  }
  .name {
    grid-area: name;
    font-weight: 500;
  }
  .via {
    grid-area: via;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    opacity: 0.7;
  }
  svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
