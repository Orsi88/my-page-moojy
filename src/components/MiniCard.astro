---
// Card pequeno dos carrosséis de Articles e Library na home.
// Sem `href`, vira um card não clicável (ex.: material ainda sem arquivo).
interface Props {
  href?: string;
  external?: boolean;
  download?: boolean;
  eyebrow: string;
  title: string;
  text: string;
  action: string; // texto do rodapé (ex.: "Read", "Download PDF", "Coming soon")
  icon?: 'arrow' | 'external' | 'download';
  clone?: boolean; // cópia do carrossel infinito: fora da navegação por teclado
}
const {
  href,
  external,
  download,
  eyebrow,
  title,
  text,
  action,
  icon = 'arrow',
  clone,
} = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['mini', { static: !href }]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  download={download ? '' : undefined}
  tabindex={clone && href ? -1 : undefined}
>
  <span class="eyebrow">{eyebrow}</span>
  <span class="title">{title}</span>
  <span class="text">{text}</span>
  <span class:list={['action', { soon: !href }]}>
    {action}
    {href && (
      <svg viewBox="0 0 24 24" aria-hidden="true">
        {icon === 'download' ? (
          <path d="M12 4v12M6 11l6 6 6-6M5 20h14" />
        ) : icon === 'external' ? (
          <path d="M7 17 17 7M8 7h9v9" />
        ) : (
          <path d="M5 12h14M13 6l6 6-6 6" />
        )}
      </svg>
    )}
  </span>
</Tag>

<style>
  .mini {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    min-height: 15rem;
    padding: 1.5rem;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      border-color 200ms ease,
      transform 200ms ease;
  }
  a.mini:hover {
    border-color: var(--text-muted);
    transform: translateY(-2px);
  }
  .eyebrow {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    line-height: 1.12;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .text {
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .soon {
    align-self: flex-start;
    padding: 0.2rem 0.7rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: 999px;
  }
  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms ease;
  }
  a.mini:hover svg {
    transform: translateX(3px);
  }
</style>
