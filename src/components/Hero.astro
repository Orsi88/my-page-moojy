---
import { withBase } from '../utils/url';
// Hero: apresentação e chamadas. Textos em src/data/site.ts.
import { site } from '../data/site';
const { intro } = site;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <div class="intro">
      <p class="eyebrow reveal" style="--d: 0ms">
        {intro.eyebrow}
      </p>
      <h1 id="hero-title" class="reveal" style="--d: 90ms">
        {intro.heading} <em>{intro.headingAccent}</em>
      </h1>
      <div class="row reveal" style="--d: 200ms">
        <p class="lead">{intro.text}</p>
        <div class="actions">
          <a class="secondary" href={withBase('/articles/')}>
            {intro.secondary}
          </a>
          <a class="cta" href="#projects">
            {intro.primary}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    padding-block: 7rem 4rem;
    background: var(--bg);
  }

  /* apresentação */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 2.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .eyebrow::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  h1 {
    text-wrap: balance;
    margin: 0 0 3rem;
    font-size: clamp(3rem, 7.4vw, 6rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
  }
  h1 em {
    font-style: italic;
    color: var(--text-muted);
  }
  /* em telas estreitas, cada frase na sua linha */
  @media (max-width: 700px) {
    h1 em {
      display: block;
    }
    /* celular: menos ar para os botões caberem na primeira tela */
    .hero {
      padding-block: 5.5rem 2.5rem;
    }
    .eyebrow {
      margin-bottom: 1.75rem;
    }
    h1 {
      margin-bottom: 2rem;
    }
    .row {
      gap: 1.5rem;
      padding-top: 1.5rem;
    }
  }
  /* texto à esquerda, botões à direita; empilha em telas estreitas */
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .lead {
    flex: 1 1 28rem;
    max-width: 44rem;
    margin: 0;
    text-wrap: pretty;
    font-size: clamp(1.05rem, 1.5vw, 1.15rem);
    line-height: 1.7;
    color: var(--text-muted);
  }
  .actions {
    /* pode encolher: em telas estreitas os botões quebram linha em vez de passar da borda */
    flex: 0 1 auto;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.75rem;
    align-items: center;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.4rem;
    color: var(--bg);
    background: var(--text);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 500;
    transition: transform 200ms ease;
  }
  .cta svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 200ms ease;
  }
  .cta:hover svg {
    transform: translateX(3px);
  }
  .secondary {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: border-color 200ms ease;
  }
  .secondary:hover {
    border-color: var(--text);
  }

  /* entrada suave, em sequência; desligada com prefers-reduced-motion (global.css) */
  .reveal {
    animation: reveal 800ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
</style>
