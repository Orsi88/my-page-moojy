---
// Janela de prévia de um projeto (abre ao clicar no card em evidência do carrossel).
// Mostra tipo, descrição, linguagem, licença, contribuidores e o botão de acesso.
import { accessLabel, people, type Project } from '../data/site';
import { repoInfo } from '../utils/github';
import { withBase } from '../utils/url';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const info = project.repo ? await repoInfo(project.repo, people) : null;

// para onde o botão principal leva
const external = project.direct ? (project.appUrl ?? project.repo) : null;
const accessHref = external ?? withBase(`/projects/${project.id}/`);
const showAccess = Boolean(project.direct ? project.appUrl : project.description);
const titleId = `preview-title-${project.id}`;
// sem descrição nem repositório: o projeto ainda não foi publicado
const empty = !project.description && !project.repo;
---

<dialog class="preview" id={`preview-${project.id}`} aria-labelledby={titleId}>
  <div class:list={['inner', { empty }]} tabindex="-1" autofocus>
    <button class="close" type="button" data-close aria-label="Close preview">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18"></path>
      </svg>
    </button>

    {empty ? (
      <div class="nothing">
        <p class="eyebrow">Not published yet</p>
        <h2 id={titleId}>{project.name}</h2>
        <p class="description">
          This one hasn’t been uploaded yet. It exists, it’s just still in the oven. Check back
          soon.
        </p>
      </div>
    ) : (
      <>
        <div class="main">
          {project.kind && <p class="eyebrow">{project.kind}</p>}
          <h2 id={titleId}>{project.name}</h2>
          <p class="description">{project.description}</p>

          {info && (info.language || info.license) && (
            <dl class="meta">
              {info.language && (
                <div>
                  <dt>Language</dt>
                  <dd>{info.language}</dd>
                </div>
              )}
              {info.license && (
                <div>
                  <dt>License</dt>
                  <dd>{info.license}</dd>
                </div>
              )}
            </dl>
          )}
        </div>

        {info && info.people.length > 0 && (
          <section class="people" aria-label="Contributors">
            <h3>{info.people.length === 1 ? 'Made by' : 'Contributors'}</h3>
            <ul>
              {info.people.map((person) => (
                <li>
                  <img src={person.avatar} alt="" width="32" height="32" loading="lazy" />
                  <span class="name">{person.name}</span>
                  <a href={person.link} target="_blank" rel="noopener noreferrer">
                    {person.linkLabel}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M7 17 17 7M8 7h9v9" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {(showAccess || project.repo) && (
          <div class="actions">
            {project.repo && (
              <a class="secondary" href={project.repo} target="_blank" rel="noopener noreferrer">
                View on GitHub
              </a>
            )}
            {showAccess && (
              <a
                class="cta"
                href={accessHref}
                target={external ? '_blank' : undefined}
                rel={external ? 'noopener noreferrer' : undefined}
              >
                {accessLabel(project)}
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  {external ? <path d="M7 17 17 7M8 7h9v9" /> : <path d="M5 12h14M13 6l6 6-6 6" />}
                </svg>
              </a>
            )}
          </div>
        )}
      </>
    )}
  </div>
</dialog>

<script>
  // fecha a prévia pelo botão × ou clicando fora da janela (Esc já fecha sozinho)
  document.querySelectorAll<HTMLDialogElement>('dialog.preview').forEach((dialog) => {
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .preview {
    /* mesmo tamanho para todos os projetos, com pouco ou muito conteúdo */
    width: min(56rem, calc(100% - 2rem));
    height: min(31rem, calc(100vh - 2rem));
    max-height: none;
    overflow: hidden;
    padding: 0;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) + 6px);
    box-shadow: 0 30px 80px -20px rgb(0 0 0 / 0.35);
  }
  .preview[open] {
    animation: preview-in 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .preview::backdrop {
    background: rgb(28 29 31 / 0.45);
    backdrop-filter: blur(3px);
  }
  @keyframes preview-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }
  /* trava a rolagem da página com a prévia aberta */
  :global(html:has(dialog.preview[open])) {
    overflow: hidden;
  }

  /* duas colunas: o projeto à esquerda, quem fez à direita; botões embaixo */
  .inner {
    position: relative;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    column-gap: 2.5rem;
    height: 100%;
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
  }
  /* se sobrar conteúdo, só essa parte rola por dentro; os botões ficam no rodapé */
  .main,
  .people {
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .nothing {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
    align-self: center;
    max-width: 30rem;
  }
  .inner:focus {
    outline: none;
  }
  .actions {
    grid-column: 1 / -1;
  }
  /* celular: uma coluna, a janela cresce com o conteúdo e rola inteira por dentro */
  @media (max-width: 760px) {
    .preview {
      height: fit-content;
      max-height: calc(100dvh - 2rem);
    }
    .inner {
      display: flex;
      flex-direction: column;
      height: auto;
      max-height: calc(100dvh - 2rem);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    .main,
    .people {
      min-height: auto;
      overflow: visible;
    }
    /* o título não fica embaixo do botão de fechar */
    .eyebrow,
    h2 {
      padding-right: 3rem;
    }
  }
  .close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    color: var(--text-muted);
    background: none;
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }
  .close:hover {
    color: var(--text);
    border-color: var(--text);
  }
  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  h2 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.2rem);
    font-weight: 400;
    line-height: 1;
  }
  .description {
    margin: 1rem 0 0;
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    gap: 2.5rem;
    margin: 1.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
  .meta dt {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .meta dd {
    margin: 0.25rem 0 0;
  }

  /* coluna de contribuidores, separada por uma linha vertical */
  .people {
    align-self: start;
    margin-top: 3rem;
    padding-left: 2.5rem;
    border-left: 1px solid var(--border);
  }
  @media (max-width: 760px) {
    .people {
      margin-top: 1.5rem;
      padding: 1rem 0 0;
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
  h3 {
    margin: 0 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .people ul {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .people li {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.35rem;
  }
  .people img {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: var(--bg);
  }
  .name {
    font-weight: 500;
  }
  .people a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .people a:hover {
    color: var(--text);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem 1.75rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.8rem 1.4rem;
    font-weight: 500;
    color: var(--bg);
    background: var(--text);
    border-radius: 999px;
    text-decoration: none;
  }
  .secondary {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: border-color 200ms ease;
  }
  .secondary:hover {
    border-color: var(--text);
  }
</style>
