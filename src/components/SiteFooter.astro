---
// Rodapé (RF-011): marca e links públicos. A navegação fica só no cabeçalho.
import { publicLinks, site } from '../data/site';
const links = publicLinks.filter((l) => l.href);
---

<footer class="site-footer">
  <div class="container inner">
    <span class="brand">{site.name}</span>
    {links.length > 0 && (
      <ul aria-label="Links">
        {links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer">
              {l.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.75h4v11H3v-11Zm6.5 0h3.8v1.5h.06c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.77 2.5 4.77 5.75v5.7h-4v-5.05c0-1.2-.02-2.75-1.75-2.75-1.75 0-2.02 1.3-2.02 2.66v5.14h-4v-11Z" />
                </svg>
              )}
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</footer>

<style>
  .site-footer {
    color: var(--text-muted);
  }
  .inner {
    padding-block: 2rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }
  .brand {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    color: var(--text);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    transition: color 200ms ease;
  }
  a:hover {
    color: var(--text);
  }
  svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }
</style>
