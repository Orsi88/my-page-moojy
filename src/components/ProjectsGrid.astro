---
// Projetos da home: um carrossel por grupo (open source, aleatórios). Dados em src/data/site.ts.
// O card em evidência fica sempre centralizado; os vizinhos aparecem mais apagados.
// Clicar no card do centro abre a prévia do projeto (ProjectPreview).
import ProjectCard from './ProjectCard.astro';
import ProjectPreview from './ProjectPreview.astro';
import { projectGroups } from '../data/site';
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="container top">
    <p class="eyebrow" id="projects-title">
      Projects
    </p>
  </div>

  {projectGroups.map((group) => (
    <section
      class="group"
      aria-labelledby={`group-${group.id}`}
      aria-roledescription="carousel"
      data-carousel
    >
      <div class="container head">
        <h2 id={`group-${group.id}`}>{group.title}</h2>
      </div>
      {group.items.length ? (
        <div class="stage">
          {/* carrossel infinito: a lista aparece 3 vezes; só a do meio é "de verdade",
              as cópias dos lados preenchem as pontas e ficam escondidas de leitores de tela */}
          <ul class="track">
            {(group.items.length > 1 ? [0, 1, 2] : [1]).flatMap((copy) =>
              group.items.map((p) => (
                <li
                  class="slide"
                  aria-roledescription={copy === 1 ? 'slide' : undefined}
                  aria-label={copy === 1 ? p.name : undefined}
                  aria-hidden={copy === 1 ? undefined : 'true'}
                  data-clone={copy === 1 ? undefined : ''}
                  data-project={p.id}
                >
                  <ProjectCard project={p} clone={copy !== 1} />
                </li>
              )),
            )}
          </ul>
          {/* setas nas laterais do card em evidência */}
          {group.items.length > 1 && (
            <>
              <button
                class="arrow prev"
                type="button"
                data-prev
                aria-label={`Previous ${group.title} project`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 12H5M11 6l-6 6 6 6" />
                </svg>
              </button>
              <button
                class="arrow next"
                type="button"
                data-next
                aria-label={`Next ${group.title} project`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
              </button>
            </>
          )}
        </div>
      ) : (
        <p class="container empty">{group.empty}</p>
      )}
    </section>
  ))}

  {projectGroups
    .flatMap((g) => g.items)
    .filter((p) => !p.placeholder)
    .map((p) => (
      <ProjectPreview project={p} />
    ))}
</section>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track');
    if (!track) return;
    const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
    const n = slides.filter((slide) => !slide.hasAttribute('data-clone')).length;
    const looped = slides.length > n; // com cópias, o carrossel é infinito
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    // começa pelo card do meio da lista "de verdade"
    let active = (looped ? n : 0) + Math.floor((n - 1) / 2);

    // rola o trilho até o card ficar no centro
    const center = (i: number, smooth = true) => {
      const slide = slides[Math.max(0, Math.min(slides.length - 1, i))];
      track.scrollTo({
        left: slide.offsetLeft - (track.clientWidth - slide.offsetWidth) / 2,
        behavior: smooth && !reduceMotion.matches ? 'smooth' : 'auto',
      });
    };

    // o card mais perto do centro é o que está em evidência
    const update = () => {
      const middle = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestDistance = Infinity;
      slides.forEach((slide, i) => {
        const distance = Math.abs(slide.offsetLeft + slide.offsetWidth / 2 - middle);
        if (distance < bestDistance) {
          bestDistance = distance;
          best = i;
        }
      });
      active = best;
      slides.forEach((slide, i) => slide.toggleAttribute('data-active', i === best));
    };

    // quando a rolagem para numa cópia, pula (sem animação) para o mesmo card na
    // lista do meio: visualmente nada muda e sempre há cards dos dois lados
    const wrap = () => {
      if (!looped || (active >= n && active < 2 * n)) return;
      const target = active < n ? active + n : active - n;
      track.scrollBy({
        left: slides[target].offsetLeft - slides[active].offsetLeft,
        behavior: 'instant',
      });
      update();
    };

    let frame = 0;
    let settle = 0;
    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
        clearTimeout(settle);
        settle = window.setTimeout(wrap, 140);
      },
      { passive: true },
    );
    prev?.addEventListener('click', () => center(active - 1));
    next?.addEventListener('click', () => center(active + 1));

    slides.forEach((slide, i) => {
      // clicar num card lateral só traz ele para o centro; o do centro abre a prévia
      slide.addEventListener('click', (event) => {
        event.preventDefault();
        if (i !== active) return center(i);
        document.querySelector<HTMLDialogElement>(`#preview-${slide.dataset.project}`)?.showModal();
      });
      // navegando pelo teclado, o card focado vai para o centro
      slide.addEventListener('focusin', () => center(i));
    });

    center(active, false);
    update();
    new ResizeObserver(() => center(active, false)).observe(track);
  });

  // fecha a prévia pelo botão × ou clicando fora da janela (Esc já fecha sozinho)
  document.querySelectorAll<HTMLDialogElement>('dialog.preview').forEach((dialog) => {
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  .projects {
    --card-w: clamp(18rem, 50vw, 40rem);
    padding-bottom: clamp(4rem, 10vw, 7rem);
    scroll-margin-top: 1rem;
  }
  .top {
    padding-top: clamp(4rem, 10vw, 7rem);
    border-top: 1px solid var(--border);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 3rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .eyebrow::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  .group + .group {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .head {
    margin-bottom: 2rem;
  }
  h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 400;
    line-height: 1.05;
  }

  /* setas: nas laterais do card em evidência, na altura do meio dele */
  .stage {
    position: relative;
  }
  .arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 999px;
    box-shadow: 0 6px 20px -8px rgb(0 0 0 / 0.25);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      border-color 200ms ease,
      opacity 200ms ease;
  }
  .arrow.prev {
    left: calc(50% - var(--card-w) / 2 - 1.5rem);
  }
  .arrow.next {
    right: calc(50% - var(--card-w) / 2 - 1.5rem);
  }
  .arrow:hover:not(:disabled) {
    border-color: var(--text);
  }
  .arrow:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .arrow svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* trilho: ocupa a largura toda da tela; o espaço nas pontas deixa o primeiro e o
     último card chegarem ao centro */
  .track {
    position: relative;
    display: flex;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin: 0;
    padding: 0.5rem calc(50% - var(--card-w) / 2) 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .slide {
    flex: 0 0 var(--card-w);
    scroll-snap-align: center;
    opacity: 0.45;
    transform: scale(0.94);
    transition:
      opacity 350ms ease,
      transform 350ms ease;
  }
  .slide[data-active] {
    opacity: 1;
    transform: none;
  }
  .slide:not([data-active]) :global(.card) {
    cursor: pointer;
  }

  .empty {
    margin: 0;
    padding-block: 2rem;
    border-block: 1px solid var(--border);
    color: var(--text-muted);
  }

  @media (max-width: 700px) {
    .projects {
      --card-w: 86vw;
    }
    .arrow {
      display: none;
    }
  }
</style>
