---
// Projetos da home: um carrossel por grupo (open source, aleatórios). Dados em src/data/site.ts.
// Clicar no card do centro abre a prévia do projeto (ProjectPreview).
import Carousel from './Carousel.astro';
import ProjectCard from './ProjectCard.astro';
import ProjectPreview from './ProjectPreview.astro';
import { projectGroups, type Project } from '../data/site';
---

<section id="projects" class="projects" aria-labelledby="projects-title">
  <div class="container top">
    <p class="eyebrow" id="projects-title">
      Projects
    </p>
  </div>

  {projectGroups.map((group) => (
    <section class="group" aria-labelledby={`group-${group.id}`}>
      <div class="container head">
        <h2 id={`group-${group.id}`}>{group.title}</h2>
      </div>
      {group.items.length ? (
        <Carousel
          items={group.items}
          label={`${group.title} projects`}
          keyOf={(p: Project) => p.id}
          nameOf={(p: Project) => p.name}
          previewOf={(p: Project) => (p.placeholder ? undefined : `preview-${p.id}`)}
        >
          {(p: Project, clone: boolean) => <ProjectCard project={p} clone={clone} />}
        </Carousel>
      ) : (
        <p class="container empty">{group.empty}</p>
      )}
    </section>
  ))}

  {projectGroups
    .flatMap((g) => g.items)
    .filter((p) => !p.placeholder)
    .map((p) => (
      <ProjectPreview project={p} />
    ))}
</section>

<style>
  .projects {
    padding-bottom: clamp(4rem, 10vw, 7rem);
    /* ao clicar em "See the projects", a tela para com o título da seção a 2,5rem do topo
       (pula o espaço vazio acima da linha divisória) */
    scroll-margin-top: calc(2.5rem - clamp(4rem, 10vw, 7rem));
  }
  .top {
    padding-top: clamp(4rem, 10vw, 7rem);
    border-top: 1px solid var(--border);
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 3rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .eyebrow::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  .group + .group {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .head {
    margin-bottom: 2rem;
  }
  h2 {
    margin: 0;
    font-size: clamp(2.2rem, 4.5vw, 3.2rem);
    font-weight: 400;
    line-height: 1.05;
  }
  .empty {
    margin: 0;
    padding-block: 2rem;
    border-block: 1px solid var(--border);
    color: var(--text-muted);
  }
</style>
