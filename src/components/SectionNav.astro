---
// Navegação fixa das páginas de projeto em tela cheia: pontinhos na lateral (um por seção)
// e um botão no canto que leva para a próxima seção (na última, volta ao topo).
// As cores vêm de --nav-ink e --nav-soft, definidas pela página.
interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---

<nav class="section-nav" aria-label="Page sections">
  <ol>
    {sections.map((s) => (
      <li>
        <a href={`#${s.id}`} data-id={s.id}>
          <span class="label">{s.label}</span>
          <span class="dot" aria-hidden="true" />
        </a>
      </li>
    ))}
  </ol>
</nav>
<button class="next-section" type="button" aria-label="Next section" title="Next section">
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M6 9l6 6 6-6"></path>
  </svg>
</button>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.section-nav a')];
  const sections = links
    .map((a) => document.getElementById(a.dataset.id!))
    .filter((el): el is HTMLElement => el !== null);
  const next = document.querySelector<HTMLButtonElement>('.next-section');

  const atBottom = () =>
    window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;

  // a seção atual é a última cujo topo já passou do topo da tela (com folga) (ou a última, no fim da página)
  const currentIndex = () => {
    if (atBottom()) return sections.length - 1;
    const line = window.innerHeight * 0.15;
    let index = 0;
    sections.forEach((s, i) => {
      if (s.getBoundingClientRect().top <= line) index = i;
    });
    return index;
  };

  const update = () => {
    const index = currentIndex();
    links.forEach((a, i) => {
      if (i === index) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
    const atEnd = index === sections.length - 1;
    next?.classList.toggle('up', atEnd);
    next?.setAttribute('aria-label', atEnd ? 'Back to top' : 'Next section');
    next?.setAttribute('title', atEnd ? 'Back to top' : 'Next section');
  };

  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      update();
      ticking = false;
    });
  };

  next?.addEventListener('click', () => {
    if (next.classList.contains('up')) {
      window.scrollTo({ top: 0 });
      return;
    }
    sections[currentIndex() + 1]?.scrollIntoView({ block: 'start' });
  });

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();
</script>

<style>
  .section-nav {
    position: fixed;
    right: clamp(0.75rem, 2vw, 1.75rem);
    top: 50%;
    z-index: 20;
    padding: 0.35rem;
    background: color-mix(in srgb, var(--nav-bg, transparent) 70%, transparent);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    transform: translateY(-50%);
  }
  ol {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    position: relative;
    display: flex;
    align-items: center;
    padding: 0.3rem;
    color: var(--nav-ink, currentColor);
    text-decoration: none;
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border: 1.5px solid var(--nav-soft, currentColor);
    border-radius: 999px;
    transition:
      transform 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease;
  }
  a[aria-current] .dot {
    background: var(--nav-ink, currentColor);
    border-color: var(--nav-ink, currentColor);
    transform: scale(1.35);
  }
  a:hover .dot {
    border-color: var(--nav-ink, currentColor);
  }
  /* o nome aparece num balãozinho à esquerda, sem ocupar espaço */
  .label {
    position: absolute;
    right: calc(100% + 0.6rem);
    padding: 0.25rem 0.6rem;
    font-size: 0.8rem;
    white-space: nowrap;
    background: var(--nav-bg, transparent);
    border-radius: 999px;
    opacity: 0;
    transform: translateX(6px);
    pointer-events: none;
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }
  a:hover .label,
  a:focus-visible .label {
    opacity: 1;
    transform: none;
  }

  .next-section {
    position: fixed;
    right: clamp(0.75rem, 2vw, 1.75rem);
    bottom: clamp(0.75rem, 2.5vh, 1.75rem);
    z-index: 20;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--nav-ink, currentColor);
    background: color-mix(in srgb, var(--nav-bg, transparent) 70%, transparent);
    border: 1px solid var(--nav-soft, currentColor);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    cursor: pointer;
    transition:
      border-color 200ms ease,
      transform 250ms ease;
  }
  .next-section:hover {
    border-color: var(--nav-ink, currentColor);
  }
  .next-section svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: nudge 2.4s ease-in-out infinite;
  }
  .next-section.up {
    transform: rotate(180deg);
  }
  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .next-section svg {
      animation: none;
    }
  }
  /* no celular os pontinhos atrapalham a leitura: fica só o botão */
  @media (max-width: 820px) {
    .section-nav {
      display: none;
    }
  }
</style>
