---
import { stripBase, withBase } from '../utils/url';
import ThemeToggle from './ThemeToggle.astro';
import { nav, site } from '../data/site';

interface Props {
  overHero?: boolean;
}
const { overHero = false } = Astro.props;
const path = stripBase(Astro.url.pathname);
const isCurrent = (href: string) =>
  !href.includes('#') && (href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, '')));
---

<header class:list={['site-header', { 'over-hero': overHero }]}>
  <div class="container bar">
    <a class="brand" href={withBase('/')}>
      {site.name}
    </a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      Menu
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={withBase(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle />
    </nav>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const navEl = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    navEl?.classList.toggle('open', !open);
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--border);
  }
  .site-header.over-hero {
    position: absolute;
    inset: 0 0 auto;
    border: 0;
    color: var(--text);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
  }
  .brand {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: inherit;
    text-decoration: none;
  }
  nav,
  ul {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: inherit;
    text-decoration: none;
    padding-block: 0.25rem;
  }
  nav a[aria-current='page'] {
    border-bottom: 2px solid currentColor;
  }
  .menu-btn {
    display: none;
    font: inherit;
    color: inherit;
    background: none;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
  }
  @media (max-width: 640px) {
    .menu-btn {
      display: block;
    }
    nav {
      display: none;
      position: absolute;
      top: 100%;
      right: var(--space);
      flex-direction: column;
      align-items: flex-start;
      padding: 1rem 1.25rem;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    nav.open {
      display: flex;
    }
    ul {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
