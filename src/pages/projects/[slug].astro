---
// Página de cada projeto: /projects/<id>/. Dados em src/data/site.ts.
// Cada tipo de projeto mostra o que faz sentido: abrir o app, baixar a versão mais
// recente ou instalar no próprio servidor.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allProjects, type Project } from '../../data/site';
import { formatDate } from '../../utils/articles';
import { latestRelease } from '../../utils/releases';
import { withBase } from '../../utils/url';

export function getStaticPaths() {
  // projetos "diretos" (como o Toki) não têm página: o card abre o próprio app
  return allProjects
    .filter((project) => !project.direct && !project.placeholder)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
const release = project.release ? await latestRelease(project.release) : null;
const releasesPage = project.release ? `https://github.com/${project.release}/releases` : null;
---

<BaseLayout
  title={project.name}
  description={project.description ?? `${project.name}, a project by Moojy.`}
>
  <article class="container project">
    <a class="back" href={withBase('/#projects')}>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M19 12H5M11 6l-6 6 6 6"></path>
      </svg>
      Projects
    </a>

    <header>
      {project.kind && <p class="eyebrow">{project.kind}</p>}
      <h1>{project.name}</h1>
      <p class="lead">
        {project.description ?? 'Details soon. It’s on the list, somewhere near the top.'}
      </p>

      <div class="actions">
        {project.appUrl ? (
          <a class="cta" href={project.appUrl} target="_blank" rel="noopener noreferrer">
            Open {project.name}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7 17 17 7M8 7h9v9" />
            </svg>
          </a>
        ) : (
          project.appUrl === null && <span class="soon">Coming soon</span>
        )}
        {project.repo && (
          <a class="secondary" href={project.repo} target="_blank" rel="noopener noreferrer">
            View on GitHub
          </a>
        )}
      </div>
    </header>

    {project.preview && (
      <img
        class="shot"
        src={withBase(project.preview)}
        alt={`${project.name} screenshot`}
        width="1280"
        height="800"
      />
    )}

    {project.release && (
      <section class="block" aria-labelledby="download-title">
        <h2 id="download-title">Download</h2>
        {release && release.downloads.length ? (
          <>
            <ul class="downloads">
              {release.downloads.map((d) => (
                <li>
                  <a href={d.url}>
                    <span class="d-label">{d.label}</span>
                    <span class="d-file">
                      {d.file} · {d.size}
                    </span>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M12 4v12M6 11l6 6 6-6M5 20h14" />
                    </svg>
                  </a>
                </li>
              ))}
            </ul>
            <p class="note">
              Version {release.version}, released {formatDate(release.date)}.{' '}
              <a href={release.url} target="_blank" rel="noopener noreferrer">
                Release notes
              </a>
            </p>
          </>
        ) : (
          <p class="note">
            Downloads live on{' '}
            <a href={releasesPage} target="_blank" rel="noopener noreferrer">
              GitHub Releases
            </a>
            .
          </p>
        )}
      </section>
    )}

    {project.selfHost && (
      <section class="block" aria-labelledby="install-title">
        <h2 id="install-title">Run your own</h2>
        <p class="note">You need Docker with Compose. Then:</p>
        <pre set:text={project.selfHost.commands} />
        <p class="note">
          <a href={project.selfHost.docs} target="_blank" rel="noopener noreferrer">
            Full installation guide
          </a>
        </p>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .project {
    --measure: 48rem;
    padding-block: clamp(3rem, 8vw, 5rem) clamp(4rem, 10vw, 7rem);
  }
  .back,
  header,
  .block {
    max-width: var(--measure);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .back:hover {
    color: var(--text);
  }
  svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: none;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 1.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .eyebrow::before {
    content: '';
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  h1 {
    margin: 0;
    font-size: clamp(3.5rem, 9vw, 6.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.015em;
  }
  .lead {
    margin: 1.75rem 0 2.5rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 1.4rem;
    font-weight: 500;
    color: var(--bg);
    background: var(--text);
    border-radius: 999px;
    text-decoration: none;
  }
  .soon {
    padding: 0.55rem 1.1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: 999px;
  }
  .secondary {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    padding-bottom: 2px;
    transition: border-color 200ms ease;
  }
  .secondary:hover {
    border-color: var(--text);
  }

  .shot {
    display: block;
    width: 100%;
    height: auto;
    margin-top: 4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .block {
    margin-top: 4rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  h2 {
    margin: 0 0 1.5rem;
    font-size: 2rem;
    font-weight: 400;
  }
  .downloads {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .downloads li {
    border-bottom: 1px solid var(--border);
  }
  .downloads a {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'label icon'
      'file icon';
    align-items: center;
    column-gap: 1rem;
    padding-block: 1.1rem;
    color: var(--text);
    text-decoration: none;
  }
  .d-label {
    grid-area: label;
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.2;
  }
  .d-file {
    grid-area: file;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .downloads svg {
    grid-area: icon;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--text-muted);
    transition:
      transform 200ms ease,
      color 200ms ease;
  }
  .downloads a:hover .d-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .downloads a:hover svg {
    color: var(--text);
    transform: translateY(2px);
  }
  .note {
    margin: 0;
    color: var(--text-muted);
  }
  .note a {
    color: var(--text);
    text-underline-offset: 0.2em;
  }
  pre {
    margin: 0 0 1.25rem;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.9rem;
    line-height: 1.7;
    color: #e8e6e1;
    background: #1f2430;
    border-radius: var(--radius);
  }
  .block > .note:first-of-type {
    margin-bottom: 1rem;
  }
</style>
