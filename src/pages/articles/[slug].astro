---
import { withBase } from '../../utils/url';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, publishedArticles, readingTime, type Article } from '../../utils/articles';

export async function getStaticPaths() {
  const articles = await publishedArticles();
  return articles.map((entry, i) => ({
    params: { slug: entry.id },
    // vizinhos para a navegação no fim do texto (lista vai do mais novo ao mais antigo)
    props: { entry, newer: articles[i - 1], older: articles[i + 1] },
  }));
}

interface Props {
  entry: Article;
  newer?: Article;
  older?: Article;
}
const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="container article">
    <header>
      <a class="back" href={withBase('/articles/')}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M19 12H5M11 6l-6 6 6 6"></path>
        </svg>
        Articles
      </a>
      <p class="meta">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readingTime(entry)} min read</span>
      </p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {(newer || older) && (
      <nav class="pager" aria-label="More articles">
        {older ? (
          <a href={withBase(`/articles/${older.id}/`)}>
            <span class="dir">Previous</span>
            <span class="t">{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a class="next" href={withBase(`/articles/${newer.id}/`)}>
            <span class="dir">Next</span>
            <span class="t">{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    --measure: 40rem;
    padding-block: clamp(3rem, 8vw, 5rem) clamp(4rem, 10vw, 7rem);
  }
  header,
  .prose,
  .pager {
    max-width: var(--measure);
    margin-inline: auto;
  }
  header {
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--border);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 3rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }
  .back:hover {
    color: var(--text);
  }
  .back svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .meta {
    display: flex;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  h1 {
    margin: 0;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .lead {
    margin: 1.5rem 0 0;
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  /* texto do artigo (vem do Markdown, por isso :global) */
  .prose {
    font-size: 1.075rem;
    line-height: 1.8;
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre),
  .prose :global(figure),
  .prose :global(table) {
    margin: 0 0 1.5rem;
  }
  .prose :global(h2) {
    margin: 3rem 0 1rem;
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.15;
  }
  .prose :global(h3) {
    margin: 2.25rem 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .prose :global(a) {
    color: var(--text);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .prose :global(a:hover) {
    color: var(--accent);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.25rem;
  }
  .prose :global(li + li) {
    margin-top: 0.4rem;
  }
  .prose :global(blockquote) {
    padding-left: 1.5rem;
    border-left: 2px solid var(--text);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    line-height: 1.4;
    font-style: italic;
    color: var(--text);
  }
  .prose :global(code) {
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 0.88em;
    padding: 0.15em 0.35em;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
  }
  .prose :global(pre) {
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.6;
    border-radius: var(--radius);
  }
  .prose :global(pre code) {
    padding: 0;
    background: none;
    border: 0;
    font-size: inherit;
  }
  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .prose :global(hr) {
    margin: 3rem auto;
    width: 4rem;
    border: 0;
    border-top: 1px solid var(--border);
  }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
  }
  .prose :global(th),
  .prose :global(td) {
    padding: 0.6rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  /* anterior / próximo */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .pager a {
    display: grid;
    gap: 0.35rem;
    color: var(--text);
    text-decoration: none;
  }
  .pager .next {
    text-align: right;
  }
  .dir {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .t {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.2;
  }
  .pager a:hover .t {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
</style>
